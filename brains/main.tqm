      "is": {
        "dqm": "Deterministic Query Model—sub-millisecond, zero-hallucination tree lookup engine.",
        "opencore": "Modern modular bootloader that injects kexts and patches ACPI tables to run macOS on PC hardware.",
        "kext": "Kernel Extension—macOS driver files injected by OpenCore into the kernel space.",
        "lilu": "The core open-source kext patcher required as a prerequisite by almost all modern macOS kexts.",
        "virtualsmc": "Advanced SMC emulator for Hackintosh systems replacing the legacy FakeSMC.",
        "whatevergreen": "Lilu plugin providing comprehensive patches for AMD, Intel, and Nvidia GPUs on macOS.",
        "applealc": "Lilu plugin that enables native macOS AppleHDA audio without modifying system files.",
        "acpi": "Advanced Configuration and Power Interface—hardware abstraction tables read by operating systems at boot.",
        "ssdt": "Secondary System Description Table—used in OpenCore to hotpatch hardware definitions into ACPI.",
        "dsdt": "Differentiated System Description Table—the main firmware table describing PC motherboards.",
        "nvram": "Non-Volatile RAM—holds boot arguments like -v, alcid, and SIP configs across hardware restarts.",
        "sip": "System Integrity Protection—macOS security mechanism restricting root actions on system files.",
        "propertree": "Cross-platform GUI plist editor built in Python specifically optimized for OpenCore config.plist files.",
        "drs": "Drag Reduction System—opens the rear wing flap in DRS zones to reduce aerodynamic drag.",
