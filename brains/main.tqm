  "routes": {
    "what": {
      "is": {
        "dqm": [
          "Deterministic Query Model (DQM): a rule-based lookup engine that follows predefined word paths in stored data.",
          "A tree-style text lookup system that returns answers stored in its knowledge base rather than generating them freely.",
          "An offline query system built from nested dictionaries; answer quality depends on the accuracy and coverage of the stored entries."
        ],
        "opencore": [
          "OpenCore is an open-source bootloader used to start macOS on supported Apple hardware and in some Hackintosh configurations.",
          "It helps configure the boot process, but does not make every PC compatible with macOS; hardware support and licensing constraints still apply."
        ],
        "kext": [
          "Kernel Extension (kext): a macOS kernel component that can provide low-level functionality such as hardware support.",
          "Kexts have historically been used for drivers and system extensions, though modern macOS increasingly favors System Extensions and DriverKit."
        ],
        "cpu": [
          "Central Processing Unit: the main general-purpose processor that executes program instructions and calculations.",
          "The CPU is a computer’s main processor; on desktops it may sit in a motherboard socket, while many laptops use soldered processors."
        ],
        "gpu": [
          "Graphics Processing Unit: a processor specialized for graphics and highly parallel workloads such as rendering and some scientific computations.",
          "A GPU may be integrated into a processor or provided as a separate chip or graphics card."
        ],
        "ram": [
          "Random Access Memory (RAM): fast working memory used to hold data and instructions that programs are actively using.",
          "Most system RAM is volatile, so its contents are normally lost when power is removed."
        ],
        "ssd": [
          "Solid-State Drive (SSD): a storage device that usually stores data in flash memory rather than spinning magnetic disks.",
          "SSDs are generally faster and quieter than hard disk drives, though actual speed depends on the device and workload."
        ],
        "nvme": [
          "NVMe (Non-Volatile Memory Express) is a storage protocol designed for non-volatile memory devices connected over PCI Express.",
          "Many NVMe SSDs use the M.2 form factor, but M.2 is a physical connector/form factor and does not by itself mean a drive is NVMe."
        ],
        "motherboard": [
          "The main circuit board that connects your CPU, memory, storage, graphics card, and power supply together.",
          "The central backbone board that lets all computer hardware components communicate."
        ],
        "psu": [
          "Power Supply Unit (PSU): converts AC power from the outlet into the DC voltages used by computer components.",
          "A PSU must provide sufficient capacity and suitable power connectors for the system; build quality and protections vary by model."
        ],
        "bios": [
          "BIOS (Basic Input/Output System) is legacy motherboard firmware that initializes hardware and starts the boot process.",
          "Most modern PCs use UEFI firmware, which performs the modern equivalent of many BIOS functions; the setup screen is only one interface to that firmware."
        ],
        "drs": [
          "Drag Reduction System (DRS) was a Formula 1 system that let a driver adjust a rear-wing flap in designated zones under specified conditions to reduce drag.",
          "DRS was used through the 2025 season. In 2026, F1 moved to active front- and rear-wing aerodynamics and a separate Overtake Mode; these are not simply the old DRS under a new name."
        ],
        "ers": [
          "Energy Recovery System (ERS): a hybrid system that recovers energy, stores it, and makes it available for later use.",
          "In Formula 1, the rules for recovering and deploying energy change by season. The 2026 power units use a revised electrical system with much greater electrical power and no MGU-H."
        ],
        "mguk": "Motor Generator Unit–Kinetic (MGU-K): an electric machine that converts some of a car’s kinetic energy into electrical energy during deceleration and can use stored electrical energy to help drive the car, within the applicable rules.",
        "mguh": "Motor Generator Unit–Heat (MGU-H): the turbocharger-linked energy-recovery component used in Formula 1’s previous hybrid power-unit rules. It recovered energy associated with exhaust heat and turbocharger operation, and was removed for 2026.",
        "porpoising": [
          "When a race car bounces up and down at high speeds because underfloor air repeatedly stalls and regains suction.",
          "Severe bouncing caused by rapid changes in air pressure under ground-effect race cars."
        ],
        "slipstream": [
          "A slipstream is the region of disturbed, often lower-pressure air behind a moving vehicle that can reduce drag for a following vehicle.",
          "Following in another car’s slipstream can increase straight-line speed, although turbulent air can reduce aerodynamic performance in corners."
        ],
        "apex": [
          "In racing, the apex is the point on the inside of a corner that a chosen racing line passes closest to.",
          "The ideal apex depends on the corner, racing line, grip, and desired exit speed; it is not always the geometric midpoint."
        ],
        "telemetry": [
          "Telemetry is the collection and transmission of measurements from remote sensors or equipment to a monitoring system.",
          "In motorsport, telemetry may include data such as speed, throttle, brake pressure, suspension movement, and temperatures; availability depends on the system and rules."
        ],
        "undervolting": [
          "Undervolting reduces the voltage supplied to a processor or graphics chip in an attempt to lower power use and heat.",
          "Results vary by chip and workload; too little voltage can cause instability, and lower voltage does not guarantee unchanged performance."
        ],
        "overclocking": [
          "Overclocking means running a CPU, GPU, or other component above its rated operating frequency, which can increase performance but may also increase heat and instability.",
          "Extra voltage is sometimes used for stability but is not always necessary; results and risks depend on the hardware and settings."
        ],
        "delidding": [
          "Delidding is removing a processor’s integrated heat spreader to access the thermal interface between it and the silicon die.",
          "It is sometimes done to replace the internal thermal interface material, but it can permanently damage a CPU and is not a beginner cooling upgrade."
        ],
        "mqb": [
          "Modularer Querbaukasten: The shared platform Volkswagen uses to build cars like the Golf, Audi A3, and Skoda Octavia.",
          "A modular vehicle blueprint shared across many front-wheel-drive Volkswagen Group cars."
        ],
        "ea888": [
          "EA888 is a family of Volkswagen Group turbocharged, direct-injection petrol engines, commonly including 1.8-litre and 2.0-litre variants used in various Volkswagen, Audi, Škoda, and SEAT/CUPRA models.",
          "Power, hardware, and tuning potential differ by generation and model; claims about large gains from simple modifications are not universal."
        ],
        "dsg": [
          "Direct-Shift Gearbox (DSG): a dual-clutch automated transmission used in some Volkswagen Group vehicles.",
          "A dual-clutch transmission can preselect the next gear for quick shifts; shift speed and smoothness depend on the gearbox design and driving conditions."
        ],
        "haldex": [
          "Haldex is a name commonly used for an electronically controlled multi-plate clutch system found in some Volkswagen Group all-wheel-drive vehicles.",
          "Depending on generation and vehicle, the system can vary how much torque reaches the rear axle; it is not accurate to say it only sends power rearward after the front wheels lose traction."
        ],
        "archipelago": [
          "A large group, cluster, or chain of islands scattered across an ocean or sea.",
          "A collection of many islands gathered together, such as Indonesia, Japan, or the Philippines."
        ],
        "equator": [
          "The equator is the imaginary line at 0° latitude that divides Earth into the Northern and Southern Hemispheres.",
          "Day and night are close to 12 hours each near the equator through the year, though exact daylight duration varies slightly with the date and how sunrise and sunset are defined."
        ],
        "fjord": [
          "A fjord is a long, deep, narrow sea inlet with steep sides, formed when a glacially carved valley is flooded by the sea.",
          "Fjords are especially common on formerly glaciated coasts such as Norway’s, but their exact shape and surroundings vary."
        ],
        "tundra": [
          "Tundra is a cold, largely treeless biome in which low temperatures and short growing seasons restrict tree growth.",
          "Permafrost is common in Arctic tundra, but it is not present in every tundra environment; vegetation can include mosses, lichens, grasses, and low shrubs."
        ],
        "taiga": [
          "The taiga, or boreal forest, is a broad subarctic biome dominated by coniferous trees across parts of Canada, Alaska, Scandinavia, and Russia.",
          "Many taiga trees are evergreen, though larches are conifers that shed their needles each year."
        ],
        "pangea": [
          "Pangaea (also spelled Pangea) was a supercontinent that brought most of Earth’s landmasses together during the late Paleozoic and early Mesozoic eras.",
          "It broke apart over geological time as tectonic plates moved, forming the continents and ocean basins seen today."
        ],
        "strait": [
          "A narrow channel of sea water connecting two larger bodies of water.",
          "A skinny passage of water passing between two coastlines, like the Strait of Gibraltar."
        ],
        "isthmus": [
          "A narrow strip of dry land with sea on both sides that links two larger land areas together.",
          "A skinny land bridge connecting two larger land masses, such as the Isthmus of Panama."
        ],
        "peninsula": [
          "A piece of land surrounded by water on three sides while remaining attached to the mainland.",
          "A stretch of land that juts far out into the water, such as Florida, Korea, or Italy."
        ],
        "delta": [
          "A river delta is a landform created when a river deposits sediment as it enters a slower-moving body of water, often forming multiple channels.",
          "Many deltas are roughly triangular or fan-shaped, but their shapes vary with sediment supply, waves, tides, and currents."
        ],
        "atoll": [
          "An atoll is a ring-shaped coral reef, often enclosing a lagoon.",
          "Many atolls develop around volcanic islands as reefs grow and the island subsides or erodes, but the details of formation vary."
        ],
        "glacier": [
          "A glacier is a persistent body of land ice formed from accumulated, compacted snow that deforms and flows under its own weight.",
          "Glaciers can move slowly through mountain valleys or across broad land areas."
        ],
        "plateau": [
          "A plateau is a broad area of relatively level land that stands higher than the surrounding area.",
          "Plateaus may have steep edges, but not every plateau is surrounded by sharp drops."
        ],
        "canyon": [
          "A canyon is a deep valley with steep sides, commonly carved by a river over long periods.",
          "Canyons can also be shaped by uplift, erosion, glaciers, and other geological processes; their formation is not always the same."
        ],
        "oasis": [
          "An oasis is a place in an arid region where water is available, allowing vegetation and sometimes settlement to exist.",
          "The water may come from springs, groundwater, wells, or other sources; an oasis is not necessarily surrounded only by sand."
        ],
        "monsoon": [
          "A monsoon is a seasonal shift in winds that often brings a pronounced wet season and dry season to affected regions.",
          "Monsoon rainfall patterns vary by region and year; the term does not simply mean any period of heavy rain."
        ],
        "gravity": [
          "Gravity is the interaction that influences the motion of bodies with mass and energy. In Newtonian physics it is modelled as attraction between masses; general relativity describes gravity through spacetime curvature.",
          "Near Earth’s surface, gravity gives objects weight and helps keep the Moon and artificial satellites in orbit."
        ],
        "friction": [
          "Friction is a force that opposes relative motion, or the tendency for relative motion, between surfaces in contact.",
          "Friction can slow objects down, provide traction, and produce heat."
        ],
        "inertia": [
          "Inertia is the tendency of an object to maintain its state of rest or uniform straight-line motion unless a net external force acts on it.",
          "An object’s mass is a measure of its inertia."
        ],
        "photosynthesis": [
          "Photosynthesis is the process by which plants, algae, and some bacteria use light energy to make energy-rich compounds from carbon dioxide and water; oxygen is released in oxygenic photosynthesis.",
          "In plants, chlorophyll and other pigments capture light energy that supports the production of sugars."
        ],
        "dna": [
          "Deoxyribonucleic acid (DNA) is a molecule that stores hereditary information in organisms and many viruses.",
          "DNA contains genes and regulatory sequences, but not every part is a direct instruction for making a protein, and organisms also depend on cellular processes and environmental conditions."
        ],
        "atom": [
          "An atom has a nucleus containing protons and, in most cases, neutrons, with electrons occupying the surrounding quantum states.",
          "Atoms are the basic units of chemical elements; hydrogen-1 is a common example of an atom with no neutron."
        ],
        "molecule": [
          "A molecule is a group of two or more atoms chemically bonded together, such as H₂O or CO₂.",
          "Not every chemical compound consists of separate molecules; ionic solids, for example, form extended lattices."
        ],
        "atmosphere": [
          "An atmosphere is a layer of gas surrounding a celestial body, held there by gravity.",
          "Earth’s atmosphere contains mostly nitrogen and oxygen; different layers and processes affect temperature and the amount of radiation reaching the surface."
        ],
        "eclipse": [
          "An eclipse occurs when one celestial body moves into the shadow of another or blocks it from view.",
          "A solar eclipse occurs when the Moon passes between Earth and the Sun; a lunar eclipse occurs when the Moon moves into Earth’s shadow."
        ],
        "black": {
          "hole": [
            "A black hole is a region of spacetime whose event horizon marks the boundary beyond which light cannot escape to a distant observer.",
            "Black holes form through several possible processes; their interiors are not directly observable, and descriptions of a singularity depend on theories that are not yet complete."
